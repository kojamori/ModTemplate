{
  "$schema": "http://json.schemastore.org/template",
  "author": "kojamori",
  "classifications": ["Game", "Mod", "SFS"],
  "identity": "kojamori.SFS.Templates.CodeMod",
  "name": "SFS Code Mod Template",
  "shortName": "sfsmod",
  "sourceName": "generatedModNameId",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "assemblyName": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": ""
    },
    "generatedAssemblyName": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "source": "assemblyName,generatedModNameId",
        "sourceVariableName": "assemblyName",
        "fallbackVariableName": "generatedModNameId"
      },
      "replaces": "generatedAssemblyName"
    },

    "autoCopyMod": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "generatedAutoCopyMod": {
      "type": "derived",
      "valueSource": "autoCopyMod",
      "valueTransform": "lowerCaseForm",
      "replaces": "generatedAutoCopyMod"
    },

    "rootNamespace": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": ""
    },
    "generatedRootNamespace": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "source": "rootNamespace,generatedModNameId",
        "sourceVariableName": "rootNamespace",
        "fallbackVariableName": "generatedModNameId"
      },
      "replaces": "generatedRootNamespace"
    },

    "modNameId": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": ""
    },
    "generatedModNameId": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "source": "modNameId,name",
        "sourceVariableName": "modNameId",
        "fallbackVariableName": "name"
      },
      "replaces": "generatedModNameId"
    },

    "modDisplayName": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": ""
    },
    "generatedModDisplayName": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "source": "modDisplayName,generatedModNameId",
        "sourceVariableName": "modDisplayName",
        "fallbackVariableName": "generatedModNameId"
      },
      "replaces": "generatedModDisplayName"
    },

    "author": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "replaces": "author"
    },
    "minimumGameVersion": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "1.6.00.18",
      "replaces": "minimumGameVersion"
    },
    "modVersion": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "1.0.0",
      "replaces": "modVersion"
    },
    "modDescription": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "replaces": "modDescription"
    },
    "updateLink": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": ""
    },
    "licenseType": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "MIT",
      "choices": [
        {
          "choice": "MIT",
          "description": "MIT License"
        },
        {
          "choice": "LGPL (v3)",
          "description": "GNU Lesser General Public License v3"
        },
        {
          "choice": "GPL (v3)",
          "description": "GNU General Public License v3"
        },
        {
          "choice": "AGPL (v3)",
          "description": "GNU Affero General Public License v3"
        },
        {
          "choice": "apache2.0",
          "description": "Apache License 2.0"
        },
        {
          "choice": "mozilla2.0",
          "description": "Mozilla Public License 2.0"
        },
        {
          "choice": "unlicense",
          "description": "The Unlicense"
        }
      ],
      "replaces": "licenseType"
    },
    "copyrightYear": {
      "type": "generated",
      "generator": "now",
      "replaces": "copyrightYear",
      "parameters": {
        "format": "yyyy"
      }
    },
    "copyrightHolder": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": ""
    },
    "generatedCopyrightHolder": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "source": "copyrightHolder,author",
        "sourceVariableName": "copyrightHolder",
        "fallbackVariableName": "author"
      },
      "replaces": "generatedCopyrightHolder"
    },

    "git": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true"
    },
    "discordLink": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": ""
    },
    "readMeDescription": {
      "type": "parameter",
      "datatype": "string",
      "parameters": {
        "sourceVariableName": ""
      }
    },
    "generatedReadMeDescription": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "source": "readMeDescription,modDescription",
        "sourceVariableName": "readMeDescription",
        "fallbackVariableName": "modDescription"
      },
      "replaces": "generatedReadMeDescription"
    },
    "harmony": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true"
    },
    "implicitManagedReferences": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true"
    },
    "generatedImplicitManagedReferences": {
      "type": "derived",
      "valueSource": "implicitManagedReferences",
      "valueTransform": "lowerCaseForm",
      "replaces": "generatedImplicitManagedReferences"
    }
  },
  "forms": {
    "lowerCaseForm": {
      "identifier": "lowerCase"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(licenseType == 'MIT')",
          "exclude": [
            "LICENSE.AGPLv3",
            "LICENSE.apache2.0",
            "LICENSE.GPLv3",
            "LICENSE.LGPLv3",
            "LICENSE.mozilla2.0",
            "LICENSE.unlicense"
          ],
          "rename": {
            "LICENSE.MIT": "LICENSE"
          }
        },
        {
          "condition": "(licenseType == 'LGPL (v3)')",
          "exclude": [
            "LICENSE.AGPLv3",
            "LICENSE.apache2.0",
            "LICENSE.GPLv3",
            "LICENSE.MIT",
            "LICENSE.mozilla2.0",
            "LICENSE.unlicense"
          ],
          "rename": {
            "LICENSE.LGPLv3": "LICENSE"
          }
        },
        {
          "condition": "(licenseType == 'GPL (v3)')",
          "exclude": [
            "LICENSE.AGPLv3",
            "LICENSE.apache2.0",
            "LICENSE.LGPLv3",
            "LICENSE.MIT",
            "LICENSE.mozilla2.0",
            "LICENSE.unlicense"
          ],
          "rename": {
            "LICENSE.GPLv3": "LICENSE"
          }
        },
        {
          "condition": "(licenseType == 'AGPL (v3)')",
          "exclude": [
            "LICENSE.apache2.0",
            "LICENSE.GPLv3",
            "LICENSE.LGPLv3",
            "LICENSE.MIT",
            "LICENSE.mozilla2.0",
            "LICENSE.unlicense"
          ],
          "rename": {
            "LICENSE.AGPLv3": "LICENSE"
          }
        },
        {
          "condition": "(licenseType == 'apache2.0')",
          "exclude": [
            "LICENSE.AGPLv3",
            "LICENSE.GPLv3",
            "LICENSE.LGPLv3",
            "LICENSE.MIT",
            "LICENSE.mozilla2.0",
            "LICENSE.unlicense"
          ],
          "rename": {
            "LICENSE.apache2.0": "LICENSE"
          }
        },
        {
          "condition": "(licenseType == 'mozilla2.0')",
          "exclude": [
            "LICENSE.AGPLv3",
            "LICENSE.apache2.0",
            "LICENSE.GPLv3",
            "LICENSE.LGPLv3",
            "LICENSE.MIT",
            "LICENSE.unlicense"
          ],
          "rename": {
            "LICENSE.mozilla2.0": "LICENSE"
          }
        },
        {
          "condition": "(licenseType == 'unlicense')",
          "exclude": [
            "LICENSE.AGPLv3",
            "LICENSE.apache2.0",
            "LICENSE.GPLv3",
            "LICENSE.LGPLv3",
            "LICENSE.MIT",
            "LICENSE.mozilla2.0"
          ],
          "rename": {
            "LICENSE.unlicense": "LICENSE"
          }
        }
      ]
    }
  ],
  "postActions": [
    {
      "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
      "condition": "(git)",
      "description": "Initialize local Git repository",
      "manualInstructions": [
        {
          "text": "Run 'git init'."
        }
      ],
      "args": {
        "args": "init",
        "executable": "git"
      },
      "continueOnError": true
    }
  ]
}
